<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>de.internal.awareness</groupId>
    <artifactId>phishing-awareness-trainer</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>phishing-awareness-trainer</name>
    <description>phishing-awareness-trainer</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <!-- Serverseitige HTML-Oberfläche: Spring MVC + eingebetteter Servlet-Container -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Serverseitiges HTML-Templating -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Bean Validation (Jakarta Validation / Hibernate Validator) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Admin-Zugriffsschutz: Spring Security (Version aus dem Spring-Boot-4.1.1-BOM). Schuetzt die
            gesamte Verwaltungs-/Versand-/Auswertungsoberflaeche per SecurityFilterChain (anyRequest
            authenticated) mit gezielten permitAll-Ausnahmen; der oeffentliche Trainingslink GET /t/{token}
            bleibt ohne Login erreichbar. Genau EIN Admin-Benutzer, ausschliesslich aus Environment-Variablen
            (APP_ADMIN_USERNAME/APP_ADMIN_PASSWORD); keine Benutzerverwaltung/DB, keine Secrets im Code/Repo.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Persistenz: Spring Data JPA (Hibernate ORM) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Mailversand: Spring JavaMailSender + Jakarta Mail (Angus). SMTP-Zugangsdaten kommen
            AUSSCHLIESSLICH aus externer Konfiguration (Environment/Spring-Properties), nie aus dem
            Code, dem Repository, der DB oder Templates. Ohne gesetztes spring.mail.host wird kein
            funktionsfaehiger Sender erwartet; der Versand ist zusaetzlich per Safety-Flag deaktiviert.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- SQLite JDBC-Treiber (Version aus dem Spring-Boot-4.1.1-BOM: org.xerial:sqlite-jdbc) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <!--
            Apache POI (OOXML): Erzeugung passiver .docx-Trainingsdokumente. Version NICHT im Spring-Boot-BOM
            verwaltet, daher explizit gepinnt (5.3.0, lokal verfuegbar, Java 21-kompatibel). Es wird
            AUSSCHLIESSLICH geschrieben, nie fremdes OOXML geparst. Erzeugt werden normale Office-Open-XML-
            Dokumente OHNE Makros, OHNE externe Relationships/Templates, OHNE eingebettete Objekte und OHNE
            Remote-Referenzen (siehe DocxGenerator + DocxGeneratorTest). Ebenso fuer passive .xlsx/.pptx
            (XlsxGenerator/PptxGenerator + Tests). poi-ooxml zieht poi, poi-ooxml-lite,
            xmlbeans, commons-compress und commons-io transitiv; log4j-api (POI-Logging) wird von
            spring-boot-starter-logging via log4j-to-slf4j nach SLF4J/Logback gebrueckt.
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>

        <!--
            Apache PDFBox: Erzeugung passiver .pdf-Trainingsdokumente. Version NICHT im Spring-Boot-BOM
            verwaltet, daher explizit gepinnt (3.0.5, lokal verfuegbar, Java 21-kompatibel). Es wird
            AUSSCHLIESSLICH geschrieben, im Produktivcode nie ein fremdes PDF geparst (Loader/PDFTextStripper
            nur in Tests). Erzeugt werden reine Text-PDFs mit Standard-14-Schriften (keine Font-Einbettung,
            keine Bilder) OHNE JavaScript, OHNE OpenAction/Aktionen (Launch/URI/GoToR/SubmitForm), OHNE
            Annotationen/Links, OHNE Formulare (AcroForm), OHNE eingebettete Dateien und OHNE Verschluesselung
            (siehe PdfGenerator + PdfGeneratorTest). pdfbox zieht pdfbox-io und fontbox (3.0.5) transitiv;
            commons-logging ist bereits ueber spring-core im Classpath (Version 1.3.6 aus dem Spring-Boot-BOM,
            Weiterleitung nach SLF4J/Logback) - kein Versionskonflikt. Die optionalen BouncyCastle-
            Abhaengigkeiten (nur fuer Signatur/Verschluesselung) werden NICHT gezogen.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>

        <!--
            Hibernate Community Dialects: stellt org.hibernate.community.dialect.SQLiteDialect bereit.
            Version aus dem BOM (= hibernate.version, exakt passend zu hibernate-core). Keine
            explizite Version, um Versionskonflikte mit hibernate-core zu vermeiden.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
        </dependency>

        <!--
            Flyway = alleinige Schemaverwaltung. In Spring Boot 4 liegt die Flyway-AutoConfig im
            Modul spring-boot-flyway; flyway-core allein genuegt nicht. SQLite-Support ist in
            flyway-core enthalten (es gibt KEIN flyway-database-sqlite). Version aus dem BOM (12.4.0).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Spring Boot 4 hat die Test-Slices modularisiert; sie sind NICHT mehr in
            spring-boot-starter-test enthalten. Fuer @DataJpaTest, TestEntityManager und
            @AutoConfigureTestDatabase werden die passenden Module benoetigt (Version aus dem BOM).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            MVC-Test-Slice (modularisiert in Spring Boot 4, nicht in spring-boot-starter-test enthalten):
            stellt @AutoConfigureMockMvc + MockMvcAutoConfiguration bereit. MockMvc selbst kommt aus
            spring-test (via starter-test). Nur fuer die Controller-/MVC-Tests, daher test-scope.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Spring Security Test (Boot-Starter): bringt spring-security-test (@WithMockUser, MockMvc-
            Post-Processors csrf()/formLogin()/user()) UND die Boot-Autokonfiguration
            SecurityMockMvcAutoConfiguration, die @AutoConfigureMockMvc automatisch springSecurity()
            anwendet (sonst greift @WithMockUser nicht). Security wird in Tests NICHT global abgeschaltet;
            die MVC-Tests bilden das reale Sicherheitsmodell ab (authentifizierter Testbenutzer + CSRF bei POST).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                Tests: PDFBox scannt beim ersten Standard-14-Font einmalig die Systemschriften und schreibt einen
                Font-Cache (Default: ~/.pdfbox.cache im Benutzerverzeichnis). Fuer Testlaeufe wird der Cache nach
                target/ umgelenkt, damit Tests nichts ausserhalb des Build-Verzeichnisses schreiben. Version des
                Plugins aus dem Spring-Boot-Parent; nur diese eine Systemeigenschaft wird ergaenzt.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <pdfbox.fontcache>${project.build.directory}</pdfbox.fontcache>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
